# Aplicação
APP_URL=http://localhost:3000
APP_NAME=Space Pay Gateway
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres
COOKIE_SECURE=false
ADMIN_EMAIL=admin@spacepay.local

# Banco Supabase/PostgreSQL (a service role fica somente no servidor)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Provedor: sandbox ou mercadopago
PAYMENT_PROVIDER=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Segurança e tarefas internas
CRON_SECRET=troque-por-uma-chave-aleatoria
WEBHOOK_SIGNING_SECRET=troque-por-outra-chave-aleatoria
DEFAULT_FEE_BPS=199
DEFAULT_FIXED_FEE_CENTS=49
ALLOW_OPEN_REGISTRATION=true
